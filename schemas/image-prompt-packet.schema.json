{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kubrick.local/schemas/image-prompt-packet.schema.json",
  "title": "Kubrick image prompt packet receipt",
  "type": "object",
  "required": ["artifact_id", "artifact_type", "authority", "result"],
  "properties": {
    "artifact_id": {"type": "string"},
    "artifact_type": {"enum": ["image-prompt-packet", "image-sequence-packet", "visual-reference-packet"]},
    "authority": {"type": "string"},
    "result": {
      "type": "object",
      "properties": {
        "packet": {
          "type": "object",
          "properties": {
            "provider": {"type": "string"},
            "frames": {"type": "array", "minItems": 1}
          }
        }
      }
    }
  }
}
